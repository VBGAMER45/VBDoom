    SetWeapon 5, am_cell, S_PLASMAUP, S_PLASMADOWN, S_PLASMA, S_PLASMA1, S_PLASMAFLASH1
    SetWeapon 6, am_cell, S_BFGUP, S_BFGDOWN, S_BFG, S_BFG1, S_BFGFLASH1
    SetWeapon 7, am_noammo, S_SAWUP, S_SAWDOWN, S_SAW, S_SAW1, S_NULL
