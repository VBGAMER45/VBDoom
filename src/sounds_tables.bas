Private Sub SetSfx(ByVal i As Long, ByVal nm As String, ByVal singularity As Boolean, ByVal priority As Long, ByVal lnk As Long, ByVal pitch As Long, ByVal volume As Long)
    S_sfx(i).name = nm
    S_sfx(i).singularity = singularity
    S_sfx(i).priority = priority
    S_sfx(i).link = lnk
    S_sfx(i).pitch = pitch
    S_sfx(i).volume = volume
    S_sfx(i).lumpnum = -1
    S_sfx(i).usefulness = 0
End Sub
